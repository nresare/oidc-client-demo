# Application configuration for oidc-client-demo

[app]
secret_key_path = "session-key"
base_url = "http://localhost:8080"
# Optional HTTPS listener with HTTP/2 via ALPN; set both PEM file paths.
# tls_cert_path = "tls/cert.pem"
# tls_key_path = "tls/key.pem"

[oidc]
issuer = "https://id.noa.re"
client_id = "oidc-client-demo"
scopes = ["openid", "profile", "email"]
# For Microsoft Entra, add "offline_access" and "https://graph.microsoft.com/User.Read".
# Register the callback as a Web redirect URI and put the web app credential in this file:
# client_secret_path = "client-secret"

# Optional request tracing via OTLP/HTTP (Tempo's HTTP receiver, usually port 4318).
# [otel]
# endpoint = "http://localhost:4318/v1/traces"
# service_name = "oidc-client-demo"
